{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {"directories": ["src"]},
    "timeout": 30,
    "threads": "max",
    "logs": {"text": "var/infection.log", "summary": "var/infection-summary.log"},
    "mutators": {
        "@default": true,
        // Comparing two microtime() readings: they are never equal, so >= and > cannot differ
        "GreaterThanOrEqualTo": {
            "ignore": [
                "Janalis\\Tuink\\Session::waitUntil",
                "Janalis\\Tuink\\Session::settleFrom",
                "Janalis\\Tuink\\Driver\\ProcessDriver::pump",
                "Janalis\\Tuink\\Probe\\ProbeServer::ask",
                "Janalis\\Tuink\\Probe\\ProbeServer::connection"
            ]
        },
        "LessThan": {
            "ignore": ["Janalis\\Tuink\\Session::settleFrom"]
        },
        // How long the process driver drains the pty while it waits for the probe: only an application
        // that takes longer than one 5 ms poll to answer would notice, as a slower step
        "OneZeroFloat": {
            "ignore": ["Janalis\\Tuink\\Driver\\ProcessDriver::start"]
        }
    },
    // Every mutant must die: a surviving one is behavior no test pins down
    "minMsi": 100,
    "minCoveredMsi": 100
}
