{
    "name": "janalis/tuink",
    "description": "Behat extension for end-to-end testing of Symfony Tui applications, in process or in a real pseudo-terminal",
    "type": "library",
    "keywords": [
        "behat",
        "tui",
        "terminal",
        "e2e",
        "symfony",
        "testing",
        "bdd"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "The tuink authors",
            "homepage": "https://github.com/janalis/tuink/graphs/contributors"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "behat/behat": "^4.0",
        "revolt/event-loop": "^1.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^8.0",
        "symfony/process": "^7.4 || ^8.0",
        "symfony/string": "^8.1.9",
        "symfony/tui": "^8.2@beta"
    },
    "require-dev": {
        "carthage-software/mago": "1.60.*",
        "infection/infection": "^0.35.12",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Janalis\\Tuink\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Janalis\\Tuink\\Tests\\": "tests/",
            "Janalis\\Tuink\\Example\\": "example/src/"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "carthage-software/mago": true,
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "format": "mago format",
        "format:check": "mago format --check",
        "lint": "mago lint --minimum-fail-level=note",
        "analyze": "mago analyze --minimum-fail-level=note",
        "test": [
            "@php vendor/bin/phpunit",
            "@php vendor/bin/behat --strict",
            "@php vendor/bin/behat --strict --profile=process"
        ],
        "mutate": "@php -d pcov.enabled=1 -d pcov.directory=src vendor/bin/infection --threads=max --initial-tests-php-options=\"-d pcov.enabled=1 -d pcov.directory=src\""
    }
}
